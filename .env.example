# Supabase Configuration
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Authentication
VITE_AUTH_PASSWORD=tu-contrasena-segura

# Google Calendar (opcional — habilita la sincronización automática)
# Sin estas variables la app igual exporta .ics y genera enlaces
# "Agregar a Google Calendar"; sólo queda pendiente la sincronización automática.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CALENDAR_ID=
