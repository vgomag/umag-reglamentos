# ── Acceso a la aplicación ────────────────────────────────────────────────
# ID de cliente OAuth creado en Google Cloud Console. Sin esto no se puede
# iniciar sesión. Tiene que ser el MISMO valor que CLIENT_ID en el Apps Script.
#
# La lista de correos autorizados NO va aquí: vive en el Apps Script
# (USUARIOS_AUTORIZADOS), que es quien la hace cumplir.
VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# ── Google Sheets: donde viven convenios y solicitudes ───────────────────
# URL de la aplicación web del Apps Script publicado desde la planilla
# (google-apps-script/Codigo.gs). Termina en /exec.
VITE_SHEETS_API_URL=https://script.google.com/macros/s/AKfy.../exec
# El mismo TOKEN que definiste dentro de Codigo.gs.
VITE_SHEETS_TOKEN=tu-token-largo-y-aleatorio

# Enlaces que la app muestra en Configuración (opcionales).
VITE_SHEET_URL=https://docs.google.com/spreadsheets/d/TU_ID/edit
VITE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/TU_ID

# ── Google Calendar (opcional) ────────────────────────────────────────────
# Sin esta variable la app igual exporta .ics y genera enlaces
# "Agregar a Google Calendar"; sólo queda pendiente la sincronización automática.
# Reutiliza el mismo VITE_GOOGLE_CLIENT_ID del inicio de sesión.
VITE_GOOGLE_CALENDAR_ID=
